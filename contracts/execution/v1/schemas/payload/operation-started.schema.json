{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://documents.local/harness/v1/schemas/payload/operation-started.schema.json",
  "title": "operation.started payload v1",
  "type": "object",
  "required": ["operationKind", "status", "name"],
  "properties": {
    "operationKind": { "$ref": "../common.schema.json#/$defs/operationKind" },
    "status": { "const": "dispatched" },
    "name": { "type": "string", "minLength": 1 },
    "inputSummary": { "type": "object" },
    "inputArtifactId": { "$ref": "../common.schema.json#/$defs/id" },
    "loopId": { "$ref": "../common.schema.json#/$defs/id" },
    "agentName": { "type": "string", "minLength": 1 },
    "loopKind": { "$ref": "progress-reported.schema.json#/$defs/loopKind" },
    "round": { "type": "integer", "minimum": 1 },
    "maxRounds": { "type": "integer", "minimum": 1 },
    "phase": { "type": "string", "minLength": 1 },
    "budgetGrantId": { "$ref": "../common.schema.json#/$defs/id" },
    "budgetReservationId": { "$ref": "../common.schema.json#/$defs/id" },
    "budgetBucket": {
      "$ref": "progress-reported.schema.json#/$defs/budgetBucket"
    },
    "executionAttemptId": { "$ref": "../common.schema.json#/$defs/id" },
    "budgetSoftLimitWarningApplied": { "type": "boolean" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "loopId": true },
        "required": ["loopId"]
      },
      "then": {
        "required": ["agentName", "loopKind", "round", "maxRounds", "phase"],
        "properties": {
          "agentName": true,
          "loopKind": true,
          "round": true,
          "maxRounds": true,
          "phase": {
            "$ref": "progress-reported.schema.json#/$defs/inferencePhase"
          }
        }
      }
    },
    {
      "if": {
        "properties": { "budgetGrantId": true },
        "required": ["budgetGrantId"]
      },
      "then": {
        "required": [
          "budgetReservationId",
          "budgetBucket",
          "executionAttemptId",
          "loopId",
          "loopKind",
          "phase"
        ],
        "properties": {
          "budgetReservationId": true,
          "budgetBucket": true,
          "executionAttemptId": true,
          "loopId": true,
          "loopKind": true,
          "phase": true
        }
      }
    },
    {
      "if": {
        "properties": { "budgetBucket": { "const": "tool" } },
      "required": ["budgetBucket"]
      },
      "then": {
        "properties": {
          "operationKind": { "const": "tool_call" },
          "phase": {
            "$ref": "progress-reported.schema.json#/$defs/toolPhase"
          }
        }
      },
      "else": {
        "if": {
          "properties": { "budgetBucket": true },
          "required": ["budgetBucket"]
        },
        "then": {
          "properties": { "operationKind": { "const": "inference" } }
        }
      }
    },
    {
      "if": {
        "properties": { "budgetSoftLimitWarningApplied": { "const": true } },
        "required": ["budgetSoftLimitWarningApplied"]
      },
      "then": {
        "required": ["budgetBucket"],
        "properties": {
          "operationKind": { "const": "inference" },
          "budgetBucket": { "const": "normal" }
        }
      }
    }
  ],
  "additionalProperties": true
}
