{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://documents.local/harness/v1/schemas/payload/progress-reported.schema.json",
  "title": "progress.reported payload v1",
  "type": "object",
  "required": ["message"],
  "properties": {
    "message": { "type": "string", "minLength": 1 },
    "kind": {
      "enum": [
        "policy_snapshot",
        "ledger_snapshot",
        "budget_grant",
        "budget_reservation",
        "budget_soft_limit_reached",
        "loop_guard_triggered"
      ]
    },
    "policy": { "$ref": "#/$defs/policy" },
    "ledger": { "$ref": "#/$defs/ledger" },
    "grant": { "$ref": "#/$defs/grant" },
    "reservation": { "$ref": "#/$defs/reservation" },
    "signal": { "$ref": "#/$defs/budgetSoftLimitSignal" },
    "loopGuardSignal": { "$ref": "#/$defs/exactToolRepeatSignal" },
    "visibleEvent": { "type": "object" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "kind": { "const": "policy_snapshot" } },
        "required": ["kind"]
      },
      "then": { "required": ["policy"], "properties": { "policy": true } }
    },
    {
      "if": {
        "properties": { "kind": { "const": "ledger_snapshot" } },
        "required": ["kind"]
      },
      "then": { "required": ["ledger"], "properties": { "ledger": true } }
    },
    {
      "if": {
        "properties": { "kind": { "const": "budget_grant" } },
        "required": ["kind"]
      },
      "then": { "required": ["grant"], "properties": { "grant": true } }
    },
    {
      "if": {
        "properties": { "kind": { "const": "budget_reservation" } },
        "required": ["kind"]
      },
      "then": {
        "required": ["reservation"],
        "properties": { "reservation": true }
      }
    },
    {
      "if": {
        "properties": { "kind": { "const": "budget_soft_limit_reached" } },
        "required": ["kind"]
      },
      "then": { "required": ["signal"], "properties": { "signal": true } }
    },
    {
      "if": {
        "properties": { "kind": { "const": "loop_guard_triggered" } },
        "required": ["kind"]
      },
      "then": {
        "required": ["loopGuardSignal"],
        "properties": { "loopGuardSignal": true }
      }
    }
  ],
  "$defs": {
    "loopKind": { "enum": ["top_level", "synchronous_subagent"] },
    "inferencePhase": {
      "enum": [
        "direct_response",
        "agent_loop",
        "output_repair",
        "forced_finalization",
        "structured_output_repair",
        "memory_extraction"
      ]
    },
    "toolPhase": { "enum": ["agent_loop", "output_repair"] },
    "budgetBucket": { "enum": ["normal", "repair", "closing", "tool"] },
    "budgetPolicy": {
      "type": "object",
      "required": ["normal", "repair", "closing", "maxTokensPerInference"],
      "properties": {
        "normal": { "type": "integer", "minimum": 0 },
        "normalInferenceSoftLimit": { "type": "integer", "minimum": 0 },
        "repair": { "type": "integer", "minimum": 0 },
        "closing": { "type": "integer", "minimum": 0, "maximum": 1 },
        "maxTokensPerInference": { "type": "integer", "minimum": 1 },
        "toolCalls": { "type": "integer", "minimum": 0 },
        "toolCallSoftLimit": { "type": "integer", "minimum": 0 },
        "exactToolRepeatWarning": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "grant": {
      "type": "object",
      "required": [
        "version",
        "grantId",
        "executionId",
        "turnId",
        "loopId",
        "executionAttemptId",
        "profileId",
        "policyVersion",
        "requestedPolicy",
        "effectivePolicy",
        "grantedAt"
      ],
      "properties": {
        "version": { "const": "1" },
        "grantId": { "$ref": "../common.schema.json#/$defs/id" },
        "executionId": { "$ref": "../common.schema.json#/$defs/id" },
        "turnId": { "$ref": "../common.schema.json#/$defs/nullableId" },
        "loopId": { "$ref": "../common.schema.json#/$defs/id" },
        "executionAttemptId": { "$ref": "../common.schema.json#/$defs/id" },
        "profileId": { "const": "documents_chat_v1" },
        "policyVersion": { "const": "1" },
        "requestedPolicy": { "$ref": "#/$defs/budgetPolicy" },
        "effectivePolicy": { "$ref": "#/$defs/budgetPolicy" },
        "grantedAt": { "$ref": "../common.schema.json#/$defs/timestamp" },
        "usage": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/budgetBucket" },
          "additionalProperties": { "$ref": "#/$defs/budgetUsage" }
        }
      },
      "additionalProperties": false
    },
    "reservation": {
      "type": "object",
      "required": [
        "version",
        "reservationId",
        "grantId",
        "operationId",
        "executionAttemptId",
        "bucket",
        "phase",
        "round",
        "name",
        "status",
        "decidedAt"
      ],
      "properties": {
        "version": { "const": "1" },
        "reservationId": { "$ref": "../common.schema.json#/$defs/id" },
        "grantId": { "$ref": "../common.schema.json#/$defs/id" },
        "operationId": { "$ref": "../common.schema.json#/$defs/id" },
        "executionAttemptId": { "$ref": "../common.schema.json#/$defs/id" },
        "operationKind": { "enum": ["inference", "tool_call"] },
        "bucket": { "$ref": "#/$defs/budgetBucket" },
        "toolCallId": { "$ref": "../common.schema.json#/$defs/id" },
        "operationFingerprint": { "$ref": "../common.schema.json#/$defs/hash" },
        "operationFingerprintVersion": {
          "const": "canonical_tool_input_v1"
        },
        "phase": { "$ref": "#/$defs/inferencePhase" },
        "round": { "type": "integer", "minimum": 1 },
        "name": { "type": "string", "minLength": 1 },
        "status": { "enum": ["reserved", "denied", "consumed"] },
        "reason": { "type": "string", "minLength": 1 },
        "decidedAt": { "$ref": "../common.schema.json#/$defs/timestamp" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "bucket": { "const": "tool" } },
            "required": ["bucket"]
          },
          "then": {
            "required": ["operationKind", "toolCallId"],
            "properties": {
              "operationKind": { "const": "tool_call" },
              "phase": { "$ref": "#/$defs/toolPhase" },
              "toolCallId": true
            }
          }
        },
        {
          "if": {
            "properties": { "operationKind": { "const": "inference" } },
            "required": ["operationKind"]
          },
          "then": {
            "properties": {
              "bucket": { "enum": ["normal", "repair", "closing"] },
              "toolCallId": false,
              "operationFingerprint": false,
              "operationFingerprintVersion": false
            }
          }
        },
        {
          "if": {
            "properties": { "operationKind": { "const": "tool_call" } },
            "required": ["operationKind"]
          },
          "then": {
            "required": ["toolCallId"],
            "properties": {
              "bucket": { "const": "tool" },
              "phase": { "$ref": "#/$defs/toolPhase" },
              "toolCallId": true
            }
          }
        }
      ],
      "dependentRequired": {
        "operationFingerprint": ["operationFingerprintVersion"],
        "operationFingerprintVersion": ["operationFingerprint"]
      },
      "additionalProperties": false
    },
    "budgetUsage": {
      "type": "object",
      "required": ["granted", "reserved", "consumed", "available"],
      "properties": {
        "granted": { "type": "integer", "minimum": 0 },
        "reserved": { "type": "integer", "minimum": 0 },
        "consumed": { "type": "integer", "minimum": 0 },
        "available": { "type": "integer", "minimum": 0 },
        "softLimit": { "type": "integer", "minimum": 0 },
        "softLimitReached": { "type": "boolean" },
        "softLimitReachedAt": { "$ref": "../common.schema.json#/$defs/timestamp" },
        "softLimitTriggeringOperationId": { "$ref": "../common.schema.json#/$defs/id" },
        "softLimitWarningPending": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "budgetSoftLimitSignal": {
      "type": "object",
      "required": [
        "version",
        "grantId",
        "operationKind",
        "bucket",
        "softLimit",
        "hardLimit",
        "committed",
        "available",
        "triggeringOperationId",
        "executionAttemptId",
        "decidedAt"
      ],
      "properties": {
        "version": { "const": "1" },
        "grantId": { "$ref": "../common.schema.json#/$defs/id" },
        "operationKind": { "enum": ["inference", "tool_call"] },
        "bucket": { "enum": ["normal", "tool"] },
        "softLimit": { "type": "integer", "minimum": 1 },
        "hardLimit": { "type": "integer", "minimum": 2 },
        "committed": { "type": "integer", "minimum": 1 },
        "available": { "type": "integer", "minimum": 0 },
        "triggeringOperationId": { "$ref": "../common.schema.json#/$defs/id" },
        "executionAttemptId": { "$ref": "../common.schema.json#/$defs/id" },
        "decidedAt": { "$ref": "../common.schema.json#/$defs/timestamp" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "operationKind": { "const": "inference" } },
            "required": ["operationKind"]
          },
          "then": { "properties": { "bucket": { "const": "normal" } } }
        },
        {
          "if": {
            "properties": { "operationKind": { "const": "tool_call" } },
            "required": ["operationKind"]
          },
          "then": { "properties": { "bucket": { "const": "tool" } } }
        }
      ],
      "additionalProperties": false
    },
    "exactToolRepeatSignal": {
      "type": "object",
      "required": [
        "version",
        "guardKind",
        "action",
        "grantId",
        "loopId",
        "previousOperationId",
        "triggeringOperationId",
        "operationFingerprint",
        "operationFingerprintVersion",
        "executionAttemptId",
        "decidedAt"
      ],
      "properties": {
        "version": { "const": "1" },
        "guardKind": { "const": "immediate_exact_tool_repeat" },
        "action": { "const": "warn" },
        "grantId": { "$ref": "../common.schema.json#/$defs/id" },
        "loopId": { "$ref": "../common.schema.json#/$defs/id" },
        "previousOperationId": { "$ref": "../common.schema.json#/$defs/id" },
        "triggeringOperationId": { "$ref": "../common.schema.json#/$defs/id" },
        "operationFingerprint": { "$ref": "../common.schema.json#/$defs/hash" },
        "operationFingerprintVersion": {
          "const": "canonical_tool_input_v1"
        },
        "executionAttemptId": { "$ref": "../common.schema.json#/$defs/id" },
        "decidedAt": { "$ref": "../common.schema.json#/$defs/timestamp" }
      },
      "additionalProperties": false
    },
    "exactToolRepeatGuardState": {
      "type": "object",
      "required": [
        "detections",
        "warningIssued",
        "warningPending"
      ],
      "properties": {
        "detections": { "type": "integer", "minimum": 0, "maximum": 1 },
        "warningIssued": { "type": "boolean" },
        "warningPending": { "type": "boolean" },
        "previousOperationId": { "$ref": "../common.schema.json#/$defs/id" },
        "triggeringOperationId": { "$ref": "../common.schema.json#/$defs/id" },
        "warningAppliedToOperationId": {
          "$ref": "../common.schema.json#/$defs/id"
        }
      },
      "additionalProperties": false
    },
    "loopGuardState": {
      "type": "object",
      "required": ["exactToolRepeat"],
      "properties": {
        "exactToolRepeat": { "$ref": "#/$defs/exactToolRepeatGuardState" }
      },
      "additionalProperties": false
    },
    "operationBudget": {
      "type": "object",
      "required": ["grants", "reservations"],
      "properties": {
        "grants": {
          "type": "object",
          "propertyNames": { "$ref": "../common.schema.json#/$defs/id" },
          "additionalProperties": { "$ref": "#/$defs/grant" }
        },
        "reservations": {
          "type": "object",
          "propertyNames": { "$ref": "../common.schema.json#/$defs/id" },
          "additionalProperties": { "$ref": "#/$defs/reservation" }
        }
      },
      "additionalProperties": false
    },
    "counter": {
      "type": "object",
      "required": ["started", "finished", "unfinished", "failed"],
      "properties": {
        "started": { "type": "integer", "minimum": 0 },
        "finished": { "type": "integer", "minimum": 0 },
        "unfinished": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "tokenUsage": {
      "type": "object",
      "required": ["known", "total", "unknownOperations"],
      "properties": {
        "known": { "type": "boolean" },
        "total": { "type": "integer", "minimum": 0 },
        "unknownOperations": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "loopLedger": {
      "type": "object",
      "required": [
        "agentName",
        "loopKind",
        "maxRounds",
        "operations",
        "inferencePhases"
      ],
      "properties": {
        "agentName": { "type": "string", "minLength": 1 },
        "loopKind": { "$ref": "#/$defs/loopKind" },
        "maxRounds": { "type": "integer", "minimum": 1 },
        "normalInferenceSoftLimit": { "type": "integer", "minimum": 0 },
        "operations": {
          "type": "object",
          "required": ["inference", "tool_call"],
          "properties": {
            "inference": { "$ref": "#/$defs/counter" },
            "tool_call": { "$ref": "#/$defs/counter" }
          },
          "additionalProperties": false
        },
        "inferencePhases": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/inferencePhase" },
          "additionalProperties": { "$ref": "#/$defs/counter" }
        }
      },
      "additionalProperties": false
    },
    "policy": {
      "type": "object",
      "required": [
        "version",
        "source",
        "loopId",
        "agentName",
        "loopKind",
        "maxRounds",
        "maxOutputRepairs",
        "forcedFinalizationAvailable",
        "maxTokensPerInference"
      ],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "configVersion": { "type": "string", "minLength": 1 },
        "loopId": { "$ref": "../common.schema.json#/$defs/id" },
        "agentName": { "type": "string", "minLength": 1 },
        "loopKind": { "$ref": "#/$defs/loopKind" },
        "maxRounds": { "type": "integer", "minimum": 1 },
        "normalInferenceSoftLimit": { "type": "integer", "minimum": 0 },
        "maxOutputRepairs": { "type": "integer", "minimum": 0 },
        "forcedFinalizationAvailable": { "type": "boolean" },
        "maxTokensPerInference": { "type": "integer", "minimum": 1 },
        "maxToolCalls": { "type": "integer", "minimum": 0 },
        "toolCallSoftLimit": { "type": "integer", "minimum": 0 },
        "exactToolRepeatWarning": { "type": "boolean" },
        "grantId": { "$ref": "../common.schema.json#/$defs/id" }
      },
      "additionalProperties": false
    },
    "ledger": {
      "type": "object",
      "required": [
        "version",
        "lastSequence",
        "operations",
        "inferencePhases",
        "loops",
        "promptTokens",
        "generatedTokens",
        "completeness"
      ],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "lastSequence": { "type": "integer", "minimum": 0 },
        "operations": {
          "type": "object",
          "required": ["inference", "tool_call"],
          "properties": {
            "inference": { "$ref": "#/$defs/counter" },
            "tool_call": { "$ref": "#/$defs/counter" }
          },
          "additionalProperties": false
        },
        "inferencePhases": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/inferencePhase" },
          "additionalProperties": { "$ref": "#/$defs/counter" }
        },
        "loops": {
          "type": "object",
          "propertyNames": { "$ref": "../common.schema.json#/$defs/id" },
          "additionalProperties": { "$ref": "#/$defs/loopLedger" }
        },
        "promptTokens": { "$ref": "#/$defs/tokenUsage" },
        "generatedTokens": { "$ref": "#/$defs/tokenUsage" },
        "completeness": { "enum": ["complete", "partial"] },
        "inferenceBudget": { "$ref": "#/$defs/operationBudget" },
        "operationBudget": { "$ref": "#/$defs/operationBudget" },
        "loopGuards": {
          "type": "object",
          "propertyNames": { "$ref": "../common.schema.json#/$defs/id" },
          "additionalProperties": { "$ref": "#/$defs/loopGuardState" }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "inferenceBudget": true },
            "required": ["inferenceBudget"]
          },
          "then": { "properties": { "operationBudget": false } }
        }
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
