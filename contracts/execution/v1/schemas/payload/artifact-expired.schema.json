{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://documents.local/harness/v1/schemas/payload/artifact-expired.schema.json",
  "title": "artifact.expired payload v1",
  "type": "object",
  "required": ["artifactIds", "propagatedArtifactIds"],
  "properties": {
    "artifactIds": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "../common.schema.json#/$defs/id" },
      "uniqueItems": true
    },
    "propagatedArtifactIds": {
      "type": "array",
      "items": { "$ref": "../common.schema.json#/$defs/id" },
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
