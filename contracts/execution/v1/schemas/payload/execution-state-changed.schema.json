{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://documents.local/harness/v1/schemas/payload/execution-state-changed.schema.json",
  "title": "execution.state_changed payload v1",
  "type": "object",
  "required": ["from", "to"],
  "properties": {
    "from": {
      "oneOf": [
        { "$ref": "../common.schema.json#/$defs/executionStatus" },
        { "type": "null" }
      ]
    },
    "to": { "$ref": "../common.schema.json#/$defs/executionStatus" },
    "phase": { "type": "string", "minLength": 1 },
    "reason": { "type": "string", "minLength": 1 },
    "completionKind": { "enum": ["full", "partial"] },
    "completionReason": { "type": "string", "minLength": 1 },
    "completionSource": { "enum": ["model", "runtime_template"] },
    "partialResult": { "$ref": "#/$defs/partialResult" },
    "result": { "$ref": "../common.schema.json#/$defs/jsonValue" },
    "error": {
      "oneOf": [
        { "$ref": "../common.schema.json#/$defs/error" },
        { "type": "null" }
      ]
    }
  },
  "allOf": [
    {
      "if": { "properties": { "to": { "enum": ["completed", "failed", "cancelled"] } }, "required": ["to"] },
      "then": {
        "required": ["completionKind", "completionReason", "result", "error"],
        "properties": {
          "completionKind": true,
          "completionReason": true,
          "result": true,
          "error": true
        }
      }
    },
    {
      "if": { "properties": { "to": { "const": "failed" } }, "required": ["to"] },
      "then": { "properties": { "error": { "$ref": "../common.schema.json#/$defs/error" } } }
    },
    {
      "if": {
        "properties": { "completionSource": { "const": "runtime_template" } },
        "required": ["completionSource"]
      },
      "then": {
        "required": ["partialResult"],
        "properties": {
          "to": { "const": "completed" },
          "completionKind": { "const": "partial" },
          "completionReason": { "enum": ["budget_exhausted", "tool_budget_exhausted", "loop_detected"] },
          "partialResult": true,
          "error": { "type": "null" }
        }
      }
    }
  ],
  "$defs": {
    "partialResult": {
      "type": "object",
      "required": [
        "version", "trigger", "loopId", "grantId",
        "completedOperations", "pending"
      ],
      "properties": {
        "version": { "const": "1" },
        "trigger": { "enum": ["closing_unavailable", "closing_output_empty", "exact_tool_repeat_persisted"] },
        "loopId": { "$ref": "../common.schema.json#/$defs/id" },
        "grantId": { "$ref": "../common.schema.json#/$defs/id" },
        "completedOperations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "required": ["operationId", "toolCallId", "name", "summary"],
            "properties": {
              "operationId": { "$ref": "../common.schema.json#/$defs/id" },
              "toolCallId": { "$ref": "../common.schema.json#/$defs/id" },
              "name": { "type": "string", "minLength": 1 },
              "summary": { "type": "string", "minLength": 1, "maxLength": 200 }
            },
            "additionalProperties": false
          }
        },
        "pending": {
          "type": "array",
          "oneOf": [
            { "const": ["final_synthesis"] },
            { "const": ["strategy_change"] }
          ]
        },
        "continuation": {
          "type": "object",
          "required": ["kind", "reason"],
          "properties": {
            "kind": { "const": "new_turn" },
            "reason": { "const": "different_strategy_required" }
          },
          "additionalProperties": false
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "trigger": { "const": "exact_tool_repeat_persisted" } },
            "required": ["trigger"]
          },
          "then": {
            "required": ["continuation"],
            "properties": {
              "pending": { "const": ["strategy_change"] },
              "continuation": true
            }
          },
          "else": {
            "properties": {
              "pending": { "const": ["final_synthesis"] },
              "continuation": false
            }
          }
        }
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
