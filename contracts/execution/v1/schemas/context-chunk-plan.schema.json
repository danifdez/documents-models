{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://documents.local/harness/v1/schemas/context-chunk-plan.schema.json",
  "title": "Deterministic context chunk plan v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "sourceArtifact",
    "algorithm",
    "offsetUnit",
    "maxChunkChars",
    "reductionFanIn",
    "chunks"
  ],
  "properties": {
    "schemaVersion": { "const": "context-chunk-plan/1" },
    "sourceArtifact": {
      "type": "object",
      "required": ["artifactId", "contentHash", "size"],
      "properties": {
        "artifactId": { "$ref": "common.schema.json#/$defs/id" },
        "contentHash": { "$ref": "common.schema.json#/$defs/hash" },
        "size": { "type": "integer", "minimum": 1, "maximum": 1048576 }
      },
      "additionalProperties": false
    },
    "algorithm": { "const": "deterministic-text-boundaries/1" },
    "offsetUnit": { "const": "utf16-code-unit" },
    "maxChunkChars": { "const": 12000 },
    "reductionFanIn": { "const": 8 },
    "chunks": {
      "type": "array",
      "minItems": 2,
      "maxItems": 21,
      "items": {
        "type": "object",
        "required": ["index", "start", "end", "contentHash"],
        "properties": {
          "index": { "type": "integer", "minimum": 0 },
          "start": { "type": "integer", "minimum": 0 },
          "end": { "type": "integer", "minimum": 1 },
          "contentHash": { "$ref": "common.schema.json#/$defs/hash" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
