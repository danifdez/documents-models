{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://documents.local/harness/v1/schemas/error-envelope.schema.json",
  "title": "Harness protocol error envelope v1",
  "type": "object",
  "required": ["schemaVersion", "code", "message", "retryable"],
  "properties": {
    "schemaVersion": { "const": "error-envelope/1" },
    "code": { "type": "string", "minLength": 1 },
    "message": { "type": "string", "minLength": 1 },
    "retryable": { "type": "boolean" },
    "executionId": { "$ref": "common.schema.json#/$defs/id" },
    "stepId": { "$ref": "common.schema.json#/$defs/id" },
    "attemptId": { "$ref": "common.schema.json#/$defs/id" },
    "detailsArtifactId": { "$ref": "common.schema.json#/$defs/id" }
  },
  "additionalProperties": true
}
