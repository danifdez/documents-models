{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://documents.local/harness/v1/schemas/step.schema.json",
  "title": "Canonical execution step v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "stepId",
    "executionId",
    "stepKind",
    "status",
    "version",
    "dependsOnStepIds",
    "inputArtifactRefs",
    "work",
    "requiredCapabilities",
    "resourceKeys",
    "priority",
    "availableAt"
  ],
  "properties": {
    "schemaVersion": { "const": "step/1" },
    "stepId": { "$ref": "common.schema.json#/$defs/id" },
    "executionId": { "$ref": "common.schema.json#/$defs/id" },
    "stepKind": { "$ref": "common.schema.json#/$defs/stepKind" },
    "status": { "$ref": "common.schema.json#/$defs/stepStatus" },
    "version": { "type": "integer", "minimum": 1 },
    "dependsOnStepIds": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/id" },
      "uniqueItems": true
    },
    "inputArtifactRefs": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/artifactRef" }
    },
    "work": { "type": "object" },
    "requiredCapabilities": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "resourceKeys": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "budgetReservationId": { "$ref": "common.schema.json#/$defs/id" },
    "priority": { "type": "integer" },
    "availableAt": { "$ref": "common.schema.json#/$defs/timestamp" },
    "deadline": { "$ref": "common.schema.json#/$defs/timestamp" },
    "operationId": { "$ref": "common.schema.json#/$defs/id" },
    "currentAttemptId": { "$ref": "common.schema.json#/$defs/id" },
    "result": { "$ref": "common.schema.json#/$defs/jsonValue" },
    "error": { "$ref": "common.schema.json#/$defs/error" }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "enum": ["running", "result_received"] } }, "required": ["status"] },
      "then": {
        "properties": { "currentAttemptId": {}, "operationId": {} },
        "required": ["currentAttemptId", "operationId"]
      }
    },
    {
      "if": { "properties": { "status": { "const": "completed" } }, "required": ["status"] },
      "then": { "properties": { "result": {} }, "required": ["result"] }
    },
    {
      "if": { "properties": { "status": { "const": "failed" } }, "required": ["status"] },
      "then": { "properties": { "error": {} }, "required": ["error"] }
    }
  ],
  "additionalProperties": true
}
