{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://documents.local/harness/v1/schemas/active-memory.schema.json",
  "title": "Selected governed memory v1",
  "type": "object",
  "required": ["schemaVersion", "owner", "policy", "candidates", "activeEntries"],
  "properties": {
    "schemaVersion": { "const": "active-memory/1" },
    "owner": {
      "type": "object",
      "required": ["type", "id"],
      "properties": {
        "type": { "enum": ["assistant", "agent"] },
        "id": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "policy": {
      "type": "object",
      "required": ["selector", "maximumCandidates", "maximumActiveEntries", "maximumActiveChars"],
      "properties": {
        "selector": { "const": "lexical-overlap/1" },
        "maximumCandidates": { "const": 50 },
        "maximumActiveEntries": { "const": 8 },
        "maximumActiveChars": { "const": 6000 }
      },
      "additionalProperties": false
    },
    "candidates": {
      "type": "array",
      "maxItems": 50,
      "items": { "$ref": "#/$defs/candidate" }
    },
    "activeEntries": {
      "type": "array",
      "maxItems": 8,
      "items": { "$ref": "#/$defs/activeEntry" }
    }
  },
  "$defs": {
    "memoryType": { "enum": ["fact", "preference", "episode"] },
    "candidate": {
      "type": "object",
      "required": ["entryId", "contentHash", "type", "scoreBasisPoints", "selected"],
      "properties": {
        "entryId": { "$ref": "common.schema.json#/$defs/id" },
        "contentHash": { "$ref": "common.schema.json#/$defs/hash" },
        "type": { "$ref": "#/$defs/memoryType" },
        "scoreBasisPoints": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "selected": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "activeEntry": {
      "type": "object",
      "required": ["entryId", "name", "type", "body", "contentHash", "scoreBasisPoints", "provenance", "consent", "dataPolicy"],
      "properties": {
        "entryId": { "$ref": "common.schema.json#/$defs/id" },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "type": { "$ref": "#/$defs/memoryType" },
        "body": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "contentHash": { "$ref": "common.schema.json#/$defs/hash" },
        "scoreBasisPoints": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "provenance": { "$ref": "#/$defs/provenance" },
        "consent": { "$ref": "#/$defs/consent" },
        "dataPolicy": { "$ref": "#/$defs/dataPolicy" }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": ["sourceKind", "executionId", "turnId", "messageId", "artifactId", "artifactRevision"],
      "properties": {
        "sourceKind": { "enum": ["manual", "confirmed_tool", "import"] },
        "executionId": { "$ref": "#/$defs/nullableId" },
        "turnId": { "$ref": "#/$defs/nullableId" },
        "messageId": { "oneOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }] },
        "artifactId": { "$ref": "#/$defs/nullableId" },
        "artifactRevision": { "oneOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }] }
      },
      "additionalProperties": false
    },
    "consent": {
      "type": "object",
      "required": ["status", "basis", "consentedAt"],
      "properties": {
        "status": { "const": "granted" },
        "basis": { "enum": ["explicit_user_action", "confirmed_tool_plan", "imported_with_consent"] },
        "consentedAt": { "$ref": "common.schema.json#/$defs/timestamp" }
      },
      "additionalProperties": false
    },
    "dataPolicy": {
      "type": "object",
      "required": ["classification", "purpose", "allowedDestinations"],
      "properties": {
        "classification": { "const": "workspace" },
        "purpose": { "const": "conversation_memory" },
        "allowedDestinations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["documents", "documents-models"] }
        }
      },
      "additionalProperties": false
    },
    "nullableId": {
      "oneOf": [{ "$ref": "common.schema.json#/$defs/id" }, { "type": "null" }]
    }
  },
  "additionalProperties": false
}
