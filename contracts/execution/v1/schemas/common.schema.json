{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://documents.local/harness/v1/schemas/common.schema.json",
  "title": "Canonical execution common definitions v1",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "nullableId": {
      "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }]
    },
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "executionStatus": {
      "enum": [
        "queued",
        "running",
        "waiting",
        "completed",
        "failed",
        "cancelled"
      ]
    },
    "stepKind": {
      "enum": ["inference", "tool", "service", "code", "verification"]
    },
    "stepStatus": {
      "enum": [
        "blocked",
        "ready",
        "running",
        "result_received",
        "completed",
        "failed",
        "cancelled"
      ]
    },
    "stepAttemptStatus": {
      "enum": [
        "leased",
        "running",
        "result_received",
        "expired",
        "cancelled",
        "failed",
        "closed"
      ]
    },
    "stepResultStatus": {
      "enum": ["succeeded", "failed", "cancelled"]
    },
    "operationStatus": {
      "enum": [
        "planned",
        "prepared",
        "dispatched",
        "succeeded",
        "failed",
        "cancelled",
        "unknown",
        "not_executed"
      ]
    },
    "recoveryClass": {
      "enum": [
        "read_only_replayable",
        "idempotent",
        "effect_checked",
        "non_resumable"
      ]
    },
    "effectClass": {
      "enum": [
        "none",
        "local_reversible",
        "local_destructive",
        "external_reversible",
        "external_irreversible"
      ]
    },
    "operationKind": {
      "enum": [
        "inference",
        "tool_call",
        "http",
        "context_build",
        "browser_observation",
        "browser_action",
        "verification",
        "artifact_processing"
      ]
    },
    "dataClassification": {
      "enum": ["public", "workspace", "personal", "sensitive", "secret"]
    },
    "trustLevel": {
      "enum": [
        "trusted_policy",
        "user_instruction",
        "untrusted_data",
        "tool_observation",
        "model_generated"
      ]
    },
    "jsonValue": {
      "oneOf": [
        { "type": "object" },
        { "type": "array" },
        { "type": "string" },
        { "type": "integer" },
        { "type": "boolean" },
        { "type": "null" }
      ]
    },
    "error": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "retryable": { "type": "boolean" },
        "detailsArtifactId": { "$ref": "#/$defs/id" }
      },
      "additionalProperties": true
    },
    "artifactRef": {
      "type": "object",
      "required": ["role", "artifactId"],
      "properties": {
        "role": { "type": "string", "minLength": 1 },
        "artifactId": { "$ref": "#/$defs/id" },
        "revision": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": true
    },
    "serviceIdentity": {
      "type": "object",
      "required": ["type", "id"],
      "properties": {
        "type": { "enum": ["user", "service", "system", "local_authority"] },
        "id": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "producer": {
      "type": "object",
      "required": ["component", "instanceId", "version"],
      "properties": {
        "component": {
          "enum": ["documents-backend", "documents-models", "ia-browser"]
        },
        "instanceId": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "codeFingerprint": { "$ref": "#/$defs/hash" },
        "runtimeFingerprint": { "$ref": "#/$defs/hash" }
      },
      "additionalProperties": true
    },
    "actor": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "enum": ["user", "system", "model", "tool", "browser", "worker"]
        },
        "id": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "security": {
      "type": "object",
      "required": [
        "dataClassification",
        "purpose",
        "allowedDestinations",
        "redactionApplied"
      ],
      "properties": {
        "dataClassification": { "$ref": "#/$defs/dataClassification" },
        "purpose": { "enum": ["operation", "diagnostic", "evaluation"] },
        "allowedDestinations": {
          "type": "array",
          "items": { "enum": ["documents", "ia-browser", "ai-train"] },
          "uniqueItems": true
        },
        "redactionApplied": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "metricValue": {
      "oneOf": [{ "type": "integer", "minimum": 0 }, { "const": "unknown" }]
    }
  }
}
