{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://documents.local/harness/v1/schemas/worker-capability.schema.json",
  "title": "Effective worker step capability v1",
  "type": "object",
  "required": ["schemaVersion", "capabilityId", "stepKinds", "maxConcurrency"],
  "properties": {
    "schemaVersion": { "const": "worker-capability/1" },
    "capabilityId": { "$ref": "common.schema.json#/$defs/id" },
    "stepKinds": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "common.schema.json#/$defs/stepKind" },
      "uniqueItems": true
    },
    "taskTypes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "installedArtifactIds": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/id" },
      "uniqueItems": true
    },
    "features": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "maxConcurrency": { "type": "integer", "minimum": 1 }
  },
  "additionalProperties": true
}
