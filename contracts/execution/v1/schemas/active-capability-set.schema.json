{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://documents.local/harness/v1/schemas/active-capability-set.schema.json",
  "title": "Backend-selected turn capabilities v1",
  "type": "object",
  "required": ["schemaVersion", "owner", "selectionPolicy", "tools", "skills"],
  "properties": {
    "schemaVersion": { "const": "active-capability-set/1" },
    "owner": {
      "type": "object",
      "required": ["type", "id"],
      "properties": {
        "type": { "enum": ["assistant", "agent"] },
        "id": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "selectionPolicy": { "const": "backend-availability/1" },
    "tools": {
      "type": "array",
      "maxItems": 14,
      "items": { "$ref": "#/$defs/tool" }
    },
    "skills": {
      "type": "array",
      "maxItems": 4,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/skill" }
    }
  },
  "$defs": {
    "tool": {
      "type": "object",
      "required": ["name", "descriptorVersion", "availabilityBasis"],
      "properties": {
        "name": {
          "enum": [
            "documents.search",
            "skills.load_resource",
            "user_tasks.create",
            "agents.delegate",
            "browser.read_current_page",
            "browser.navigate",
            "browser.go_back",
            "browser.click",
            "browser.type_text",
            "workspace_files.list",
            "workspace_files.search",
            "workspace_files.read",
            "workspace_files.write",
            "workspace_files.delete"
          ]
        },
        "descriptorVersion": {
          "enum": [
            "documents.search/1",
            "skills.load_resource/1",
            "user_tasks.create/1",
            "agents.delegate/1",
            "browser.read_current_page/1",
            "browser.navigate/1",
            "browser.go_back/1",
            "browser.click/1",
            "browser.type_text/1",
            "workspace_files.list/1",
            "workspace_files.search/1",
            "workspace_files.read/1",
            "workspace_files.write/1",
            "workspace_files.delete/1"
          ]
        },
        "availabilityBasis": {
          "enum": [
            "core_read",
            "core_confirmed_effect",
            "bounded_delegation",
            "configured_folder",
            "paired_browser"
          ]
        }
      },
      "additionalProperties": false
    },
    "skill": {
      "oneOf": [
        { "$ref": "#/$defs/workspaceDocumentSkill" },
        { "$ref": "#/$defs/evidenceResearchSkill" }
      ]
    },
    "workspaceDocumentSkill": {
      "type": "object",
      "required": [
        "skillId",
        "version",
        "title",
        "description",
        "contentHash",
        "activationReason",
        "resources"
      ],
      "properties": {
        "skillId": { "const": "workspace-document-workflow" },
        "version": { "const": "workspace-document-workflow/1" },
        "title": { "const": "Workspace document workflow" },
        "description": {
          "const": "Discover, inspect, create, edit, or remove documents in the optional workspace folder."
        },
        "contentHash": {
          "const": "sha256:c755864bb8f6b113ff62c4912c20277bf66e71d37819921de46111a24c7cec91"
        },
        "activationReason": { "const": "objective_match" },
        "resources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/documentFormatResource" }
        }
      },
      "additionalProperties": false
    },
    "documentFormatResource": {
      "type": "object",
      "required": ["resourceId", "title", "description", "contentHash"],
      "properties": {
        "resourceId": { "const": "document-format-handling" },
        "title": { "const": "Document format handling" },
        "description": {
          "const": "Safety and preservation rules for editing text, binary, and container document formats."
        },
        "contentHash": {
          "const": "sha256:ccb06824a5ed7559cac8327619cb3f8de834ee44f2fda7f0460c7501df1b179c"
        }
      },
      "additionalProperties": false
    },
    "evidenceResearchSkill": {
      "type": "object",
      "required": [
        "skillId",
        "version",
        "title",
        "description",
        "contentHash",
        "activationReason",
        "resources"
      ],
      "properties": {
        "skillId": { "const": "evidence-research-workflow" },
        "version": { "const": "evidence-research-workflow/1" },
        "title": { "const": "Evidence research workflow" },
        "description": {
          "const": "Search, compare, and synthesize available sources while preserving provenance and uncertainty."
        },
        "contentHash": {
          "const": "sha256:902f4eb209b750d9b7a62c8cb9daa297158e45a284a8f857fba3a676dcea8002"
        },
        "activationReason": { "const": "objective_match" },
        "resources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/sourceEvaluationResource" }
        }
      },
      "additionalProperties": false
    },
    "sourceEvaluationResource": {
      "type": "object",
      "required": ["resourceId", "title", "description", "contentHash"],
      "properties": {
        "resourceId": { "const": "source-evaluation" },
        "title": { "const": "Source evaluation" },
        "description": {
          "const": "Criteria for provenance, corroboration, contradictions, freshness, and evidence gaps."
        },
        "contentHash": {
          "const": "sha256:3c5472ac70881363440979f779dac8ad657c662a6666495a5f667ef4a8a79879"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
