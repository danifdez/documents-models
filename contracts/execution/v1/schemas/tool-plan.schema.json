{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://documents.local/harness/v1/schemas/tool-plan.schema.json",
  "title": "Canonical tool plan v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "operationId",
    "toolCallId",
    "toolName",
    "descriptorVersion",
    "normalizedArguments",
    "resources",
    "effects",
    "policyDecision",
    "confirmationRequirement",
    "recoveryClass",
    "idempotencyKey",
    "requiredCapabilities",
    "deadline",
    "preparedAt"
  ],
  "properties": {
    "schemaVersion": { "const": "tool-plan/1" },
    "operationId": { "$ref": "common.schema.json#/$defs/id" },
    "toolCallId": { "$ref": "common.schema.json#/$defs/id" },
    "toolName": { "type": "string", "minLength": 1, "maxLength": 200 },
    "descriptorVersion": { "type": "string", "minLength": 1 },
    "normalizedArguments": { "type": "object" },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["resourceKey", "mode"],
        "properties": {
          "resourceKey": { "type": "string", "minLength": 1 },
          "mode": { "enum": ["shared", "exclusive"] },
          "kind": { "type": "string", "minLength": 1 },
          "id": { "type": "string", "minLength": 1 },
          "version": {
            "oneOf": [{ "type": "string" }, { "type": "integer" }]
          }
        },
        "additionalProperties": false
      }
    },
    "effects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["effectClass", "resourceKey", "description", "reversible"],
        "properties": {
          "effectClass": { "$ref": "common.schema.json#/$defs/effectClass" },
          "resourceKey": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "reversible": { "type": "boolean" },
          "verificationRequired": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    },
    "policyDecision": {
      "type": "object",
      "required": ["decision", "rule"],
      "properties": {
        "decision": { "enum": ["allowed", "confirmation_required", "denied"] },
        "rule": { "type": "string", "minLength": 1 },
        "conditions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "expiresAt": { "$ref": "common.schema.json#/$defs/timestamp" }
      },
      "additionalProperties": false
    },
    "confirmationRequirement": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["confirmationId", "reason", "prompt", "scope"],
          "properties": {
            "confirmationId": { "$ref": "common.schema.json#/$defs/id" },
            "reason": { "type": "string", "minLength": 1 },
            "prompt": { "type": "string", "minLength": 1 },
            "scope": { "enum": ["once", "execution"] },
            "expiresAt": { "$ref": "common.schema.json#/$defs/timestamp" }
          },
          "additionalProperties": false
        }
      ]
    },
    "recoveryClass": { "$ref": "common.schema.json#/$defs/recoveryClass" },
    "idempotencyKey": {
      "oneOf": [
        { "type": "string", "minLength": 1, "maxLength": 300 },
        { "type": "null" }
      ]
    },
    "requiredCapabilities": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1,
      "uniqueItems": true
    },
    "deadline": { "$ref": "common.schema.json#/$defs/timestamp" },
    "preparedAt": { "$ref": "common.schema.json#/$defs/timestamp" }
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "properties": {
          "policyDecision": {
            "type": "object",
            "properties": { "decision": { "const": "confirmation_required" } },
            "required": ["decision"]
          }
        },
        "required": ["policyDecision"]
      },
      "then": {
        "type": "object",
        "properties": { "confirmationRequirement": { "type": "object" } }
      },
      "else": {
        "type": "object",
        "properties": { "confirmationRequirement": { "type": "null" } }
      }
    }
  ],
  "additionalProperties": false
}
