{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://documents.local/harness/v1/schemas/active-input-reduction.schema.json",
  "title": "Reduced active user input v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "sourceArtifact",
    "planArtifact",
    "strategy",
    "chunkCount",
    "digest"
  ],
  "properties": {
    "schemaVersion": { "const": "active-input-reduction/1" },
    "sourceArtifact": {
      "type": "object",
      "required": ["artifactId", "contentHash", "size"],
      "properties": {
        "artifactId": { "$ref": "common.schema.json#/$defs/id" },
        "contentHash": { "$ref": "common.schema.json#/$defs/hash" },
        "size": { "type": "integer", "minimum": 1, "maximum": 1048576 }
      },
      "additionalProperties": false
    },
    "planArtifact": {
      "type": "object",
      "required": ["artifactId", "contentHash"],
      "properties": {
        "artifactId": { "$ref": "common.schema.json#/$defs/id" },
        "contentHash": { "$ref": "common.schema.json#/$defs/hash" }
      },
      "additionalProperties": false
    },
    "strategy": { "const": "chunk-map-reduce/1" },
    "chunkCount": { "type": "integer", "minimum": 2, "maximum": 21 },
    "digest": { "type": "string", "minLength": 1, "maxLength": 16000 }
  },
  "additionalProperties": false
}
